<Page x:Class="OctoglowSender.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Padding="32" Spacing="14" Width="620" HorizontalAlignment="Left">
        <Image Source="ms-appx:///Assets/octoglow_logo.svg" Width="52" Height="52" HorizontalAlignment="Left"/>
        <TextBlock Text="Octoglow Connect" Style="{ThemeResource TitleTextBlockStyle}"/>
        <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Opacity="0.75"/>
        <TextBlock Text="Version 1.0" Opacity="0.6"/>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0">
            <StackPanel Spacing="8">
                <TextBlock Text="Octoglow Connect" FontWeight="SemiBold"/>
                <TextBlock x:Name="AppLicenseSummaryText" Opacity="0.7"/>
                <Button x:Name="AppLicenseButton" Click="AppLicense_Click" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>
        <TextBlock x:Name="ThirdPartyTitleText" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,10,0,0"/>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0">
            <StackPanel Spacing="8">
                <TextBlock Text="SCSSdkClient / scs-sdk-plugin" FontWeight="SemiBold"/>
                <TextBlock Text="MIT License · Copyright (c) 2014 Hans" Opacity="0.7"/>
                <Button x:Name="SdkLicenseButton" Click="SdkLicense_Click" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
