<Page x:Class="OctoglowSender.ConnectionPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer><StackPanel Spacing="16" Padding="32" Width="620" HorizontalAlignment="Left">
        <TextBlock x:Name="PageTitle" Style="{ThemeResource TitleTextBlockStyle}"/>
        <Border x:Name="ConnectionStateCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
            <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon x:Name="ConnectionStateIcon" FontSize="18"/><TextBlock x:Name="ConnectionStateText" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel>
        </Border>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="IpBox"/>
            <TextBox x:Name="PortBox" Grid.Column="1"/>
        </Grid>
        <TextBox x:Name="UserBox"/>
        <PasswordBox x:Name="PassBox"/>
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="StartButton" Style="{ThemeResource AccentButtonStyle}" Click="Start_Click" Padding="16,10">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE768;"/><TextBlock x:Name="StartButtonText"/></StackPanel>
            </Button>
            <Button x:Name="StopButton" Click="Stop_Click" Padding="16,10">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE71A;"/><TextBlock x:Name="StopButtonText"/></StackPanel>
            </Button>
        </StackPanel>
        <Border x:Name="LastActivityCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Visibility="Collapsed">
            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <FontIcon x:Name="ActivityIcon" Glyph="&#xE823;" FontSize="22" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1" Spacing="3"><TextBlock x:Name="LastActivityLabel" FontWeight="SemiBold"/><TextBlock x:Name="LastActivityText" TextWrapping="Wrap" Opacity="0.82"/></StackPanel>
            </Grid>
        </Border>
    </StackPanel></ScrollViewer>
</Page>
