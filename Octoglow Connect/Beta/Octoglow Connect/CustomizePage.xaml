<Page x:Class="OctoglowSender.CustomizePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                Padding="18,12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Click="Back_Click" Width="36" Height="36" Padding="0" ToolTipService.ToolTip="Back">
                    <FontIcon Glyph="&#xE72B;"/>
                </Button>
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AddressText" FontSize="12" Opacity="0.62"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ProgressRing x:Name="LoadingRing" Width="18" Height="18" IsActive="False" Visibility="Collapsed"/>
                    <Button x:Name="ReloadButton" Click="Reload_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE72C;"/><TextBlock x:Name="ReloadButtonText"/></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <WebView2 x:Name="DeviceWebView"/>
            <InfoBar x:Name="PanelError" IsOpen="False" IsClosable="True" Severity="Error"
                     HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="18"/>
        </Grid>
    </Grid>
</Page>
