<Page x:Class="OctoglowSender.ConnectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <SolidColorBrush x:Key="ScreenLedOnBrush" Color="{ThemeResource SystemAccentColor}" />
        <SolidColorBrush x:Key="ScreenLedOffBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.12" />
    </Page.Resources>
    <ScrollViewer Padding="32">
        <StackPanel Spacing="18" MaxWidth="760" HorizontalAlignment="Left">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="PageTitle" Style="{ThemeResource TitleTextBlockStyle}"/>
                    <TextBlock x:Name="PageSubtitle" Opacity="0.68" TextWrapping="Wrap"/>
                </StackPanel>
                <Border x:Name="ConnectionStateCard" Grid.Column="1"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="14" Padding="12,6" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="ConnectionStateIcon" FontSize="15"/>
                        <TextBlock x:Name="ConnectionStateText" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="ScreenPanel"
                    CornerRadius="16"
                    Padding="16"
                    BorderThickness="1"
                    Background="#FF141414"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch">
                    <Canvas x:Name="ScreenCanvas"
                            Width="512"
                            Height="128"
                            AutomationProperties.Name="Octoglow Clock LED matrix" />
                </Viewbox>
            </Border>
            <TextBlock x:Name="ScreenStateText"
                       Opacity="0.8"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="18">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock x:Name="ModelLabel" FontSize="12" Opacity="0.62"/>
                        <TextBlock Text="Octoglow Desk Clock" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock x:Name="TransportLabel" FontSize="12" Opacity="0.62"/>
                        <TextBlock Text="Wi-Fi · HTTP" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="3">
                        <TextBlock x:Name="AddressLabel" FontSize="12" Opacity="0.62"/>
                        <TextBlock x:Name="DetectedAddressText" Text="—" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>

            <InfoBar x:Name="PresenceInfo" IsOpen="False" IsClosable="False" Severity="Warning"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="20">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock x:Name="ConnectionSectionTitle" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <TextBlock x:Name="ConnectionSectionDescription" Opacity="0.65" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="4*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="IpBox"/>
                        <TextBox x:Name="PortBox" Grid.Column="1" InputScope="Number"/>
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="UserBox"/>
                        <PasswordBox x:Name="PassBox" Grid.Column="1" PasswordRevealMode="Peek"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="StartButton" Style="{ThemeResource AccentButtonStyle}" Click="Start_Click" Padding="16,10">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE768;"/><TextBlock x:Name="StartButtonText"/></StackPanel>
                        </Button>
                        <Button x:Name="StopButton" Click="Stop_Click" Padding="16,10">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE71A;"/><TextBlock x:Name="StopButtonText"/></StackPanel>
                        </Button>
                        <Button x:Name="OpenPanelButton" Click="OpenPanel_Click" Padding="16,10">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE774;"/><TextBlock x:Name="OpenPanelButtonText"/></StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="LastActivityCard"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="18" Visibility="Collapsed" Margin="0,0,0,16">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <FontIcon x:Name="ActivityIcon" Glyph="&#xE823;" FontSize="22"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock x:Name="LastActivityLabel" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LastActivityText" TextWrapping="Wrap" Opacity="0.82"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
