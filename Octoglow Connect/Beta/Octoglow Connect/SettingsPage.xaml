<Page x:Class="OctoglowSender.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Spacing="16" Padding="32" MaxWidth="760" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock x:Name="PageTitle" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock x:Name="PageSubtitle" Opacity="0.68" TextWrapping="Wrap" />
            </StackPanel>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="18">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE771;" FontSize="18" />
                        <TextBlock x:Name="AppearanceTitle" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                    <Grid ColumnSpacing="14" RowSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="LanguageTitle" FontWeight="SemiBold" />
                            <ComboBox x:Name="LanguageBox" HorizontalAlignment="Stretch">
                                <ComboBoxItem x:Name="LanguageSystemItem" Tag="system"/>
                                <ComboBoxItem Tag="ro">Română</ComboBoxItem>
                                <ComboBoxItem Tag="en">English</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock x:Name="ThemeTitle" FontWeight="SemiBold" />
                            <ComboBox x:Name="ThemeBox" HorizontalAlignment="Stretch">
                                <ComboBoxItem x:Name="ThemeSystemItem" Tag="system"/>
                                <ComboBoxItem x:Name="ThemeLightItem" Tag="light"/>
                                <ComboBoxItem x:Name="ThemeDarkItem" Tag="dark"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="6">
                            <TextBlock x:Name="BackdropTitle" FontWeight="SemiBold" />
                            <ComboBox x:Name="BackdropBox" HorizontalAlignment="Stretch">
                                <ComboBoxItem x:Name="BackdropNoneItem" Tag="none"/>
                                <ComboBoxItem x:Name="BackdropMicaItem" Tag="mica"/>
                                <ComboBoxItem x:Name="BackdropMicaAltItem" Tag="micaalt"/>
                                <ComboBoxItem x:Name="BackdropAcrylicItem" Tag="acrylic"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="18">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE7EF;" FontSize="18" />
                        <TextBlock x:Name="AppBehaviorTitle" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="StartupSwitch" />
                    <ToggleSwitch x:Name="TraySwitch" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="18">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE74D;" FontSize="18"
                                      Foreground="{ThemeResource DeleteIconBrush}" />
                            <TextBlock x:Name="DevicesSettingsTitle"
                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="DevicesSettingsDescription"
                                   MaxWidth="500"
                                   Opacity="0.68"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="ClearDevicesButton"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="ClearDevices_Click"
                            Foreground="{ThemeResource DeleteIconBrush}" />
                </Grid>
            </Border>

            <Button x:Name="RestoreDefaultsButton" Click="RestoreDefaults_Click"
                    HorizontalAlignment="Left" Margin="0,4,0,16" />
        </StackPanel>
    </ScrollViewer>
</Page>
