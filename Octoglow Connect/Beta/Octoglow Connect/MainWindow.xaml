<Window x:Class="OctoglowSender.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:OctoglowSender"
        Title="Octoglow Connect">
    <Grid Background="{ThemeResource AppShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="20,0,168,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/octoglow_logo.svg" Width="24" Height="24" />
                <TextBlock x:Name="WindowTitle"
                           Text="Octoglow Connect"
                           Style="{ThemeResource SubtitleTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="RootNavigation"
                        Grid.Row="1"
                        Background="Transparent"
                        PaneDisplayMode="Left"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        OpenPaneLength="260"
                        CompactPaneLength="52"
                        ItemInvoked="RootNavigation_ItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItemHeader x:Name="DevicesHeader" />
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="HomeNavItem"
                                    Tag="home"
                                    Icon="Home"
                                    IsSelected="True"
                                    HorizontalContentAlignment="Left" />
                <NavigationViewItem x:Name="SettingsNavItem"
                                    Tag="settings"
                                    Icon="Setting"
                                    HorizontalContentAlignment="Left" />
                <NavigationViewItem x:Name="AboutNavItem"
                                    Tag="about"
                                    Icon="Help"
                                    HorizontalContentAlignment="Left" />
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
